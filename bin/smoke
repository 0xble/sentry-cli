#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
expected_version=$(
  awk -F '"' '/^version = / { print $2; exit }' "$repo_root/Cargo.toml"
)
bin_path="${SENTRY_CLI_SMOKE_BIN_PATH:-$repo_root/target/release/sentry-cli}"

cargo build --manifest-path "$repo_root/Cargo.toml" --release --locked >/dev/null

version_output=$("$bin_path" --version)
printf '%s\n' "$version_output" | /usr/bin/grep -Fq "sentry-cli $expected_version"
"$bin_path" --help >/dev/null

echo "smoke ok: sentry-cli"
